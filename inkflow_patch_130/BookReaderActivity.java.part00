package app.inkflow.reader;

import android.annotation.SuppressLint;
import android.app.*;
import android.content.pm.ActivityInfo;
import android.content.res.Configuration;
import android.graphics.*;
import android.graphics.drawable.GradientDrawable;
import android.os.*;
import android.view.*;
import android.view.animation.*;
import android.webkit.*;
import android.widget.*;

public class BookReaderActivity extends Activity {
    private FrameLayout root, readerBox;
    private LinearLayout topBar,bottomBar;
    private WebView web;
    private View spine;
    private TextView titleView,progressView,modeView,themeView;
    private final Handler handler=new Handler(Looper.getMainLooper());
    private BookProgressStore store;
    private BookContent book;
    private String uri,name;
    private boolean loaded=false,bars=true,animating=false;
    private int pageCount=1,currentPage=0,pageStep=1,pendingRatio=-1;
    private int fontSp,theme,mode,animation,turnMs,linePct,margins,indent,fontFamily,brightness,orientationMode;
    private boolean justify,tapZones,volumeKeys,twoPage,keepScreen;
    private GestureDetector gestures;
    private Runnable saver;

    @Override protected void onCreate(Bundle b){
        super.onCreate(b);
        uri=getIntent().getDataString(); name=getIntent().getStringExtra("name");
        if(uri==null){ finish(); return; }
        store=new BookProgressStore(this); readSettings(); applyWindowSettings(false); buildUi(); loadBook();
    }

    private void readSettings(){
        fontSp=store.getFontSp(); theme=store.getTheme(); mode=store.getMode(); animation=store.getAnimation();
        turnMs=store.getTurnMs(); linePct=store.getLinePct(); margins=store.getMargins(); indent=store.getIndent();
        fontFamily=store.getFontFamily(); justify=store.getJustify(); tapZones=store.getTapZones(); volumeKeys=store.getVolumeKeys();
        twoPage=store.getTwoPage(); keepScreen=store.getKeepScreen(); brightness=store.getBrightness(); orientationMode=store.getOrientation();
    }

    private void applyWindowSettings(boolean orientationToo){
        if(keepScreen) getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON); else getWindow().clearFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
        WindowManager.LayoutParams lp=getWindow().getAttributes(); lp.screenBrightness=brightness==0?-1f:Math.max(.05f,brightness/100f); getWindow().setAttributes(lp);
        if(orientationToo){
            int wanted=orientationMode==1?ActivityInfo.SCREEN_ORIENTATION_PORTRAIT:orientationMode==2?ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE:ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED;
            if(getRequestedOrientation()!=wanted) setRequestedOrientation(wanted);
        }
    }

    @SuppressLint({"SetJavaScriptEnabled"}) private void buildUi(){
        getWindow().setStatusBarColor(Ui.BG); getWindow().setNavigationBarColor(Ui.BG);
        root=new FrameLayout(this); root.setBackgroundColor(Ui.BG); Ui.safeInsets(root,this,0,0,0,0);
        readerBox=new FrameLayout(this); FrameLayout.LayoutParams rbp=new FrameLayout.LayoutParams(-1,-1); rbp.topMargin=Ui.dp(this,62); rbp.bottomMargin=Ui.dp(this,56); root.addView(readerBox,rbp);
        web=new WebView(this); readerBox.addView(web,new FrameLayout.LayoutParams(-1,-1));
        WebSettings ws=web.getSettings(); ws.setJavaScriptEnabled(true); ws.setDomStorageEnabled(true); ws.setBuiltInZoomControls(true); ws.setDisplayZoomControls(false); ws.setSupportZoom(true); ws.setDefaultTextEncodingName("utf-8"); ws.setLoadWithOverviewMode(false); ws.setUseWideViewPort(false);
        if(Build.VERSION.SDK_INT>=29) ws.setForceDark(WebSettings.FORCE_DARK_OFF);
        web.setBackgroundColor(bookBg()); web.setVerticalScrollBarEnabled(false); web.setHorizontalScrollBarEnabled(false);
        web.addJavascriptInterface(new Bridge(),"NativeReader");
        web.setWebChromeClient(new WebChromeClient());
        web.setWebViewClient(new WebViewClient(){ @Override public void onPageFinished(WebView v,String url){
            loaded=true; if(mode==1) handler.postDelayed(BookReaderActivity.this::restoreContinuous,100); updateProgressText();
        }});
        web.setOnScrollChangeListener((v,x,y,ox,oy)->{ if(mode==1) scheduleSave(); });
        gestures=new GestureDetector(this,new GestureDetector.SimpleOnGestureListener(){
            @Override public boolean onDown(android.view.MotionEvent e){ return true; }
            @Override public boolean onSingleTapConfirmed(android.view.MotionEvent e){
                if(mode==0 && tapZones){ float x=e.getX(),w=web.getWidth(); if(x<w*.30f){ turnPage(-1); return true; } if(x>w*.70f){ turnPage(1); return true; } }
                toggleBars(); return true;
            }
            @Override public boolean onFling(android.view.MotionEvent e1,android.view.MotionEvent e2,float vx,float vy){
                if(mode!=0 || e1==null || e2==null) return false; float dx=e2.getX()-e1.getX(),dy=e2.getY()-e1.getY();
                if(Math.abs(dx)>Ui.dp(BookReaderActivity.this,60) && Math.abs(dx)>Math.abs(dy)*1.25f){ turnPage(dx<0?1:-1); return true; } return false;
            }
        });
        web.setOnTouchListener((v,e)->{ gestures.onTouchEvent(e); return false; });

        spine=new View(this); spine.setVisibility(View.GONE); GradientDrawable gd=new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,new int[]{0x00101010,0x55101010,0xAA050505,0x55101010,0x00101010}); spine.setBackground(gd);
        FrameLayout.LayoutParams sp=new FrameLayout.LayoutParams(Ui.dp(this,18),-1,Gravity.CENTER_HORIZONTAL); readerBox.addView(spine,sp);
        buildBars(); setContentView(root);
    }

    private void buildBars(){
        topBar=new LinearLayout(this); topBar.setGravity(Gravity.CENTER_VERTICAL); topBar.setPadding(Ui.dp(this,10),Ui.dp(this,7),Ui.dp(this,10),Ui.dp(this,7)); topBar.setBackground(Ui.topBar(this)); topBar.setElevation(Ui.dp(this,10));
        TextView back=actionButton("‹",true,34); back.setOnClickListener(v->finish()); topBar.addView(back,new LinearLayout.LayoutParams(Ui.dp(this,46),Ui.dp(this,46)));
        LinearLayout titles=new LinearLayout(this); titles.setOrientation(LinearLayout.VERTICAL); titleView=Ui.text(this,name!=null?name:"Книга",14,Ui.TEXT); titleView.setTypeface(Typeface.DEFAULT_BOLD); titleView.setMaxLines(1); titleView.setEllipsize(android.text.TextUtils.TruncateAt.END); titles.addView(titleView); TextView sub=Ui.text(this,"EPUB • FB2 • TXT • HTML",10,Ui.GOLD); titles.addView(sub); LinearLayout.LayoutParams tp=new LinearLayout.LayoutParams(0,-2,1); tp.leftMargin=Ui.dp(this,8); topBar.addView(titles,tp);
        modeView=actionButton(mode==0?"КНИГА":"ЛЕНТА",false,11); modeView.setOnClickListener(v->{ setMode(mode==0?1:0); }); topBar.addView(modeView,new LinearLayout.LayoutParams(Ui.dp(this,74),Ui.dp(this,38)));
        TextView settings=actionButton("⚙",false,20); LinearLayout.LayoutParams stp=new LinearLayout.LayoutParams(Ui.dp(this,46),Ui.dp(this,46)); stp.leftMargin=Ui.dp(this,6); settings.setOnClickListener(v->showSettings()); topBar.addView(settings,stp);
        root.addView(topBar,new FrameLayout.LayoutParams(-1,Ui.dp(this,62),Gravity.TOP));

        bottomBar=new LinearLayout(this); bottomBar.setGravity(Gravity.CENTER_VERTICAL); bottomBar.setPadding(Ui.dp(this,10),Ui.dp(this,6),Ui.dp(this,10),Ui.dp(this,7)); bottomBar.setBackground(Ui.bottomBar(this)); bottomBar.setElevation(Ui.dp(this,10));
        TextView prev=actionButton("‹",false,28); prev.setOnClickListener(v->{ if(mode==0)turnPage(-1); else web.scrollBy(0,-Math.max(300,(int)(web.getHeight()*.82))); }); bottomBar.addView(prev,new LinearLayout.LayoutParams(Ui.dp(this,50),Ui.dp(this,40)));
        progressView=Ui.text(this,"0%",12,Ui.TEXT); progressView.setGravity(Gravity.CENTER); progressView.setTypeface(Typeface.DEFAULT_BOLD); bottomBar.addView(progressView,new LinearLayout.LayoutParams(0,Ui.dp(this,42),1));
        themeView=actionButton(themeName(),true,10); themeView.setOnClickListener(v->{ theme=(theme+1)%4; store.setTheme(theme); reloadPreservingProgress(); }); bottomBar.addView(themeView,new LinearLayout.LayoutParams(Ui.dp(this,72),Ui.dp(this,38)));
        TextView next=actionButton("›",false,28); LinearLayout.LayoutParams np=new LinearLayout.LayoutParams(Ui.dp(this,50),Ui.dp(this,40)); np.leftMargin=Ui.dp(this,6); next.setOnClickListener(v->{ if(mode==0)turnPage(1); else web.scrollBy(0,Math.max(300,(int)(web.getHeight()*.82))); }); bottomBar.addVie