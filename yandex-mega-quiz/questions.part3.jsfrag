  function mulberry32(a){return function(){let t=a+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
  function shuffle(arr,rng){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
  function makeChoice(id,category,difficulty,q,correct,wrong,rng,type='choice'){
    const source=type==='tf'?['Верно','Неверно']:[...new Set([correct,...wrong.slice(0,3)])];const answers=shuffle(source,rng);return{id,category,difficulty,type,q,answers,correct:answers.indexOf(correct)}
  }
