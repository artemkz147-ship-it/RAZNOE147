; Engine configuration file.
; Godot 4.7.2 project for the interactive 3D dinosaur encyclopedia.
; CI revision 2.
config_version=5

[application]
config/name="Динозавры: Живая энциклопедия"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048

[audio]
default_bus_layout="res://default_bus_layout.tres"

[physics]
common/enable_pause_aware_picking=true

[input]
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
