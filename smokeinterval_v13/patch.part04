+    private void pickSleepTime(boolean start) {
+        int minute = start ? PlanStore.getSleepStartMin(this) : PlanStore.getSleepEndMin(this);
+        int hour = minute / 60;
+        int min = minute % 60;
+        new TimePickerDialog(this, (view, h, m) -> {
+            if (start) {
+                PlanStore.setSleepWindow(this, h * 60 + m, PlanStore.getSleepEndMin(this));
+            } else {
+                PlanStore.setSleepWindow(this, PlanStore.getSleepStartMin(this), h * 60 + m);
+            }
+            applySleepChanges();
+        }, hour, min, true).show();
+    }
+
+    private static String formatTime(int minuteOfDay) {
+        int h = minuteOfDay / 60;
+        int m = minuteOfDay % 60;
+        return String.format(Locale.getDefault(), "%02d:%02d", h, m);
+    }
+
+    private static String formatTimeRange(int startMin, int endMin) {
+        return formatTime(startMin) + "–" + formatTime(endMin);
+    }
