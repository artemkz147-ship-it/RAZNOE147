         }
 
-        scheduleAt(context, triggerAt);
+        long adjusted = PlanStore.adjustNotificationTime(context, triggerAt);
+        if (adjusted < 0L || adjusted == Long.MAX_VALUE) {
+            cancel(context);
+            return;
+        }
+        scheduleAt(context, adjusted);
     }
 
     public static void scheduleAt(Context context, long triggerAtMs) {
+        if (triggerAtMs < 0L || triggerAtMs == Long.MAX_VALUE) {
+            cancel(context);
+            return;
+        }
         AlarmManager am = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
         PendingIntent pi = alarmPendingIntent(context);
 
